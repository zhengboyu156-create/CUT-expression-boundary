+                  delta=delta,samples=samples,window=dataset.opt.stats_window,demo_only=dataset.opt.pair_split=='demo',
+                  sampling_protocol=SAMPLING_PROTOCOL,protocol_hash=policy_hash(dataset.opt.stats_window))
